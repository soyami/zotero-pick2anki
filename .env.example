# npm start（zotero-plugin serve 开发模式）需要的路径配置
# 复制本文件为 .env 后按自己的环境修改；只跑 npm run build / npm test 时不需要它。

# Zotero 可执行文件（必填）
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=C:\Program Files\Zotero\zotero.exe

# 测试用 profile 与数据目录（可选；不填则用 Zotero 默认 profile）
# 强烈建议指定，避免开发调试污染你自己的 Zotero 库
ZOTERO_PLUGIN_PROFILE_PATH=
ZOTERO_PLUGIN_DATA_DIR=
